{
"1nj42rf12": "விசுவாசத்தினால் சுதந்தரிக்கப்படும் வாக்குத்தத்தங்கள் (Heb 6:12)",
"1eimy3qq": "அவிசுவாசம் வரம்பிடுகிறது (Mark 6:5)",
"12wvu0ey": "வெட்டுக்கிளிகளா அல்லது அரக்கர்களா (Num 13:33)",
"1lrbdyy12": "தேவனுடைய படையைக் காணத் திறக்கப்பட்ட கண்கள் (2 Kgs 6:17)",
"1vw6bwyq": "நீங்கள் எதிர்பார்ப்பதையே கவனிக்கிறீர்கள்",
"1cz3gc41b": "சுயதிறன் நம்பிக்கை: நீங்கள் செய்யமுடியும் என்று நம்புவதையே முயல்கிறீர்கள்",
"11vdct015": "காலேப் மலையைக் கேட்டார் (Josh 14:12)",
"1099skxl": "விசுவாசம் செயல்படுகிறது (Jas 2:17)",
"1foahh4q": "மருந்துப்போலி (placebo) மற்றும் எதிர்மறை மருந்துப்போலி (nocebo) விளைவுகள்",
"8455hfo": "மன அழுத்த ஹார்மோன்களும் பயமும்",
"auoxrj1a": "“மகிழ்ச்சியான இருதயம் நல்ல மருந்து” (Prov 17:22)",
"1v6eu0a18": "எதிர்பார்ப்புகள் பிறரை வடிவமைக்கின்றன (பிக்மேலியன் விளைவு)",
"1p1vmb013": "அன்பு “எல்லாவற்றையும் விசுவாசிக்கும்” (1 Cor 13:7)",
"secbkbx": "உடன்பாடு பெருகுகிறது (Matt 18:19)",
"1f4xbpxp": "பகிரப்பட்ட அவிசுவாசம்: நாசரேத்",
"1lghu3v1r": "பகிரப்பட்ட விசுவாசம்: சபை ஜெபிக்கிறது, இடம் அதிர்கிறது (Acts 4:31)",
"we2aw1k": "பொருளின்மேல் மனம் வெல்வது அல்ல",
"1igzv4xk": "பிறருடைய சுயாதீனத் தேர்வுகள்",
"w0lutbu": "தவிக்கிற படைப்பு (Rom 8:22)",
"4mitlfw": "ஆவிக்குரிய எதிர்ப்பு (Dan 10:13)",
"7vffb4v": "காலமும் மர்மமும் (Deut 29:29)",
"16z8uwkg": "நம்பிக்கைகளைப் புதுப்பித்தல்",
"f1dp3215": "உங்கள் நம்பிக்கை அமைப்பைச் செம்மைப்படுத்துவது ஏன் முக்கியம்",
"1sfenex31": "மறைந்திருக்கும் நம்பிக்கைகள் ஜெபத்தையும் தேர்வுகளையும் எதிர்பார்ப்புகளையும் அமைதியாக வடிவமைக்கின்றன. மனதைப் புதுப்பிப்பது பாதையை மாற்றுகிறது (Rom 12:2).",
"xydvsed": "மறைந்திருக்கும் நம்பிக்கை",
"1o45qv9g": "அது உண்டாக்குவது",
"ogxajse": "புதுப்பிக்கப்பட்ட நம்பிக்கை"
